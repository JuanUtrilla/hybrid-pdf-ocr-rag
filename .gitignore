# Los PDF del corpus no se versionan: se descargan con scripts/fetch_corpus.py
data/pdf/*.pdf

# Índices y artefactos pesados
data/index/
*.joblib
*.npz

__pycache__/
*.pyc
.venv/
.ipynb_checkpoints/

# Texto extraído de los documentos del corpus: pertenece a sus autores.
# Se regenera en local con extract_corpus.py y no se redistribuye.
out/pages/
out/native/

# Mediciones sobre material privado que no forma parte del corpus público
out/apuntes/
out/yield_apuntes/
out/qgis_profile.log

# Caché de render y OCR: contiene la página completa y su texto, se regenera
out/cache/

# Visualizaciones para divulgación: se mantienen en local, fuera del repo.
# Solo se versionan las dos figuras que usa el README.
scripts/viz_*.py
scripts/make_figure.py
scripts/cache_ocr.py
out/figuras/*
!out/figuras/contraste_ocr.png
!out/figuras/capa_corrupta.png
